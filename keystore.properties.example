# Copie para keystore.properties (ignorado pelo Git) e preencha.
# Gere a chave uma vez e GUARDE o arquivo e as senhas: sem eles não dá para atualizar o app.
#   keytool -genkeypair -v -keystore mototrack-release.jks -alias mototrack \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=mototrack-release.jks
storePassword=
keyAlias=mototrack
keyPassword=

# Gerar o APK de release (assinado, falando com a API de produção):
#   ./gradlew :app:assembleRelease -Pmototrack.apiBaseUrl=https://sua-api.exemplo.com/
# O arquivo sai em app/build/outputs/apk/release/.
